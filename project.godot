; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Night Shift"
run/main_scene="res://ui/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://core/settings.gd"
Net="*res://core/net.gd"
DebugCapture="*res://core/debug_capture.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_cast=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[internationalization]

locale/translations=PackedStringArray("res://i18n/translations.en.translation", "res://i18n/translations.vi.translation")
locale/fallback="en"

[rendering]

renderer/rendering_method="forward_plus"
